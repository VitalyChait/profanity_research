# Copy to .remote.env (which is gitignored) and fill in your server details.
# Enforce owner-only permissions: chmod 600 .remote.env
# Make sure your University VPN is connected before running `scripts/remote.sh`.

REMOTE_HOST="gpu-server.university.edu"
REMOTE_PORT="22"
REMOTE_USER="root"

# Authentication: prefer an SSH key (`bash scripts/remote.sh setup-ssh-key` can install one).
# If using password auth with sshpass, set REMOTE_PASSWORD or REMOTE_PASSWORD_FILE (never commit!).
REMOTE_SSH_KEY="${HOME}/.ssh/id_ed25519"
REMOTE_PASSWORD=""
REMOTE_PASSWORD_FILE=""

# Remote paths & benchmark profile
REMOTE_DIR="/root/profanity_research"
REMOTE_PROFILE="auto"

# University VPN / SSH reachability timeout (seconds)
VPN_CHECK_TIMEOUT="5"

# Exclusivity policy (1 = abort if another user or GPU compute job is active on the server)
REQUIRE_EXCLUSIVE="1"
MAX_IDLE_GPU_MEM_MB="500"
MAX_IDLE_GPU_UTIL_PCT="10"

# HuggingFace credentials & cache on the remote server (required for gated Llama / Gemma models)
HF_TOKEN=""
HF_HOME="/root/.cache/huggingface"
